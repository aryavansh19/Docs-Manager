SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_TOKEN=
PHONE_NUMBER_ID=
VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_VERSION=v17.0
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=
ALLOW_UNSIGNED_WEBHOOKS=false
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Local cross-encoder that rescores search results. Downloads once (~90 MB).
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Matched CLIP pair for understanding photos that contain no readable text.
IMAGE_VISION_MODEL=Qdrant/clip-ViT-B-32-vision
IMAGE_TEXT_MODEL=Qdrant/clip-ViT-B-32-text
MAX_INGESTION_FILE_BYTES=26214400
MAX_PDF_PAGES=80
MAX_DOCUMENT_CHUNKS=200

# Document naming. Both optional: with neither key set, naming falls back to the OCR
# heading and CLIP label heuristics, which is how this behaved before.
#
# Routing follows what each provider can do rather than a preference order:
#   - an image goes to Gemini, which can look at the picture itself. This is the only way
#     to correctly name a photo carrying no readable text, and it is what fixes a photo of
#     a slipper being labelled "medical prescription" by the CLIP fallback.
#   - extracted text goes to Groq, which is faster.
# Either covers for the other when only one key is set. With GROQ_API_KEY alone, photos
# with no text still fall back to CLIP, because Groq cannot see an image.
GROQ_API_KEY=
GEMINI_API_KEY=
# Model names churn and a retired name returns 404, so both are overridable here rather
# than needing a code change.
# Verified against the live model lists. Do not guess these: a wrong name is a 404 on
# every call, and model availability differs per account.
GROQ_NAMING_MODEL=openai/gpt-oss-120b
GEMINI_NAMING_MODEL=gemini-3.5-flash-lite
