# Vite inlines every VITE_* value into the JavaScript bundle at build time.
# Treat all of them as public, and redeploy after changing any of them.

# Supabase project URL and the ANON (public) key.
# Never put the service_role key here: it would be shipped to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL of the FastAPI backend, with no trailing slash.
# Local development: http://localhost:8001
VITE_API_URL=

# WhatsApp number users are told to message, e.g. +911234567890
VITE_BOT_NUMBER=
